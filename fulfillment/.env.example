# ══════════════════════════════════════════════════════════════
# DOTS FOR LOVE — Fulfillment Hub Konfiguration
# Kopiere diese Datei nach .env und trage deine Werte ein.
# ══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
PORT=3000
# Öffentliche URL dieses Hubs (Gelato lädt Druckdateien von hier herunter!)
# Muss per HTTPS erreichbar sein, z.B. https://fulfillment.dots-for-love.com
PUBLIC_URL=https://fulfillment.example.com
# Verzeichnis für Designs & Datenbank
DATA_DIR=./data

# ── Shopify ─────────────────────────────────────────────────
# Custom App anlegen: Shopify Admin → Einstellungen → Apps → Apps entwickeln
# Benötigte Scopes: read_orders, write_fulfillments, read_fulfillments,
#                   read_customers, write_customers (für Marketing-Opt-ins)
SHOPIFY_SHOP=dotsforlove.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxx
# Webhook-Secret: wird beim Anlegen des Webhooks angezeigt
# (Einstellungen → Benachrichtigungen → Webhooks)
SHOPIFY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Gelato ──────────────────────────────────────────────────
# API-Key: Gelato Dashboard → Developer → API Keys
GELATO_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Produkt-UIDs pro Größe: Gelato Katalog-API oder Dashboard → Products
# Beispiel-Format (Poster 200g/m² matt) — UIDs unbedingt mit deinem
# Gelato-Katalog abgleichen (siehe AUTOMATISIERUNG.md Abschnitt 2.3):
GELATO_PRODUCT_UID_A4=flat_product_pf_a4_pt_200-gsm-poster_cl_4-0_ct_none_prt_none_sft_none_set_none_ver
GELATO_PRODUCT_UID_A3=flat_product_pf_a3_pt_200-gsm-poster_cl_4-0_ct_none_prt_none_sft_none_set_none_ver
GELATO_PRODUCT_UID_50X70=flat_product_pf_500x700-mm_pt_200-gsm-poster_cl_4-0_ct_none_prt_none_sft_none_set_none_ver
GELATO_PRODUCT_UID_70X100=flat_product_pf_700x1000-mm_pt_200-gsm-poster_cl_4-0_ct_none_prt_none_sft_none_set_none_ver

# ── Heimdruck-Routing ───────────────────────────────────────
# Ab welchem Monatsumsatz (EUR, brutto) werden A4/A3 zuhause gedruckt?
HOME_PRINT_ENABLED=true
HOME_PRINT_MONTHLY_REVENUE_THRESHOLD=500
# Welche Größen dürfen zuhause gedruckt werden (kommagetrennt)
HOME_PRINT_SIZES=A4,A3
# Token, mit dem sich dein Heimdruck-Agent authentifiziert (frei wählbar, lang & zufällig)
PRINT_AGENT_TOKEN=bitte-langes-zufaelliges-token-eintragen

# ── Etsy (optional) ─────────────────────────────────────────
# Etsy App: https://www.etsy.com/developers/your-apps
ETSY_ENABLED=false
ETSY_API_KEY=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
# Abfrage-Intervall für neue Etsy-Bestellungen (Minuten)
ETSY_POLL_MINUTES=10
# SKU-Zuordnung Etsy-Listing → Größe erfolgt über die SKU (DFL-A4, DFL-A3, ...)

# ── Admin-Benachrichtigungen (optional) ─────────────────────
# Webhook-URL für Benachrichtigungen (z.B. Discord/Slack Incoming Webhook)
NOTIFY_WEBHOOK_URL=

# ── E-Mail-Versand (Gratis-Grüße & Erinnerungen) ───────────
# SMTP-Zugang, z.B. von deinem Hoster, Brevo (kostenlos bis 300/Tag) o.ä.
# Ohne SMTP_HOST werden Mails nur in die Konsole geloggt (Entwicklung).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dots for Love <hallo@dots-for-love.com>"
# Öffentliche Shop-URL für Links in den E-Mails
SHOP_PUBLIC_URL=https://dotsforlove.myshopify.com

# ── Erinnerungs-Marketing ───────────────────────────────────
# Rabattcode muss in Shopify existieren (Admin → Rabatte).
# Empfohlen: dein Kampagnen-Code (15 %, 1× pro Kunde).
DISCOUNT_CODE=ERINNERUNG5
DISCOUNT_PERCENT=15
# Wie viele Tage vor dem Termin die Angebots-Mail rausgeht
OFFER_LEAD_DAYS=21
